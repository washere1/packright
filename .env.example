# Backend (all values are optional)
PACKRIGHT_HOST=127.0.0.1
PACKRIGHT_PORT=8000
PACKRIGHT_DEV_ORIGIN=http://127.0.0.1:5173
PACKRIGHT_RUNTIME_DIR=runtime-data
PACKRIGHT_MAX_UPLOAD_BYTES=52428800
PACKRIGHT_PROCESSING_TIMEOUT_SECONDS=30
PACKRIGHT_PARSER_MEMORY_LIMIT_MB=2048
PACKRIGHT_MODEL_TIMEOUT_SECONDS=10
PACKRIGHT_SOLVER_BUDGET_SECONDS=2.75
PACKRIGHT_MAX_TRIP_INSTANCES=24

# Optional live enrichment. The core application works without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
